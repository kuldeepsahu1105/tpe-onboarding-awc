apiVersion: [[ apiVersion ]]
kind: Engine
metadata:
  name: [[ engine.name ]]
  annotations:
    ecosystem.awc.cloudera.com/requires-embedded-registry: "true"
spec:
  displayName: "[[ engine.displayName ]]"
  description: "[[ engine.description ]]"
  # Multi-role chart: [[ engine.roles | map(attribute='name') | join(', ') ]].
  # Add/remove roles below and in configSchema/template to match your chart's
  # real values.yaml role keys (e.g. controlplane/compute, FE/BE, leader/worker).

  versionCatalog:
    - displayName: "[[ engine.version ]]"
      imageCatalog: [[ imageCatalogName ]]
      chartCatalog: [[ chartCatalogName ]]
      metadata:
        buildVersion: "[[ engine.version ]]"

[% if dependencies.entries %]
  dependencies:
[% for dep in dependencies.entries %]
    - name: [[ dep.name ]]
      engine: [[ dep.engine ]]
      type: [[ dep.type ]]
[% if dep.get("version") is not none %]
      version: "[[ dep.version ]]"
[% endif %]
[% if dep.get("minimumVersion") is not none %]
      minimumVersion: "[[ dep.minimumVersion ]]"
[% endif %]
[% if dep.get("config") %]
      config:
[[ dep.config | toyaml | indent(8, true) ]]
[% endif %]
[% endfor %]

[% endif %]
  configSchema:
    type: object
    properties:
[% for role in (engine.roles if engine.configFromRoles else []) %]
      [[ role.name ]]Replicas:
        type: integer
        default: [[ role.replicas ]]
        minimum: 1
        description: "Number of [[ role.name ]] replicas"
[% if role.resources | default(true) %]
      [[ role.name ]]Cpu:
        type: string
        default: "[[ role.cpu | default(cluster.minCpu) ]]"
        description: "CPU request/limit per [[ role.name ]] pod"
      [[ role.name ]]Memory:
        type: string
        default: "[[ role.memory | default(cluster.minMemory) ]]"
        description: "Memory request/limit per [[ role.name ]] pod"
[% endif %]
[% if engine.roleStorage %]
      [[ role.name ]]StorageSize:
        type: string
        default: "[[ cluster.diskDefault ]]"
        description: "Persistent volume size per [[ role.name ]] pod"
[% endif %]
[% endfor %]
[% for e in config.extras %]
      [[ e.name ]]:
        type: [[ e.type ]]
[% if e.minimum is defined %]
        minimum: [[ e.minimum ]]
[% endif %]
        default: [[ e.default | tojson ]]
        description: "[[ e.description ]]"
[% if e.title is defined %]
        title: "[[ e.title ]]"
[% endif %]
[% endfor %]

  provides:
[% if provides %]
[% for pr in provides %]
    - name: [[ pr.name ]]
      capability: [[ pr.capability ]]
      value: |
[[ pr.value | indent(8, true) ]]
[% endfor %]
[% else %]
[% if service.hasLandingPage %]
    - name: landingPage
      capability: landing-page
      value: |
        url: "https://[[ service.landingHost ]]"
[% endif %]
[% if capability.exportsStructuredData %]
    - name: connection
      capability: [[ capability.name ]]
      value: |
[% for f in capability.fields %]
        [[ f.name ]]: "{{ .Metadata.Name }}"
[% endfor %]
[% elif service.endpointUrl %]
    - name: endpoint
      capability: endpoint
      value: |
        url: "http://[[ service.endpointHost ]].{{ .Metadata.Namespace }}.svc.cluster.local:[[ service.port ]]"
[% else %]
    - name: endpoint
      capability: service
      value: |
        host: "[[ service.endpointHost ]].{{ .Metadata.Namespace }}.svc.cluster.local"
        port: [[ service.port ]]
[% endif %]
[% endif %]

  healthChecks:
    - resource:
        apiVersion: helm.toolkit.fluxcd.io/v2
        kind: HelmRelease
        name: "{{ .Metadata.Name }}"
      condition:
        type: Ready
        status: "True"

  template: |
    apiVersion: security.awc.cloudera.com/v1alpha1
    kind: AuthConfig
    metadata:
      name: default
      namespace: "{{ .Metadata.Namespace }}"
    spec:
      meshMode: Ambient
      enableAWCAuth: false
    ---
    apiVersion: source.toolkit.fluxcd.io/v1
    kind: HelmRepository
    metadata:
      name: "{{ .Metadata.Name }}-repo"
    spec:
      interval: 5m
      type: oci
      url: oci://{{ .Chart.[[ helm.chartId ]].registry }}/{{ dir .Chart.[[ helm.chartId ]].repository }}
    ---
    apiVersion: helm.toolkit.fluxcd.io/v2
    kind: HelmRelease
    metadata:
      name: "{{ .Metadata.Name }}"
    spec:
      interval: 1m
      timeout: 20m
      install:
        createNamespace: true
        timeout: 15m
        remediation:
          retries: 3
      targetNamespace: "{{ .Metadata.Namespace }}"
      chart:
        spec:
          chart: "{{ base .Chart.[[ helm.chartId ]].repository }}"
          version: "{{ .Chart.[[ helm.chartId ]].version }}"
          sourceRef:
            kind: HelmRepository
            name: "{{ .Metadata.Name }}-repo"
            namespace: "{{ .Metadata.Namespace }}"
      values:
[% if helm.valuesTemplate %]
[[ helm.valuesTemplate | indent(8, true) ]]
[% else %]
        nameOverride: "{{ .Metadata.Name }}"
        image:
          repository: "{{ .Image.[[ helm.imageId ]].registry }}/{{ .Image.[[ helm.imageId ]].repository }}"
          tag: "{{ .Image.[[ helm.imageId ]].tag }}"
[% if helm.pullPolicy %]
          pullPolicy: [[ helm.pullPolicy ]]
[% endif %]
[% for role in (engine.roles if engine.configFromRoles else []) %]
        [[ role.name ]]:
          replicas: "{{ .Config.[[ role.name ]]Replicas }}"
[% if role.resources | default(true) %]
          resources:
            requests:
              cpu: "{{ .Config.[[ role.name ]]Cpu }}"
              memory: "{{ .Config.[[ role.name ]]Memory }}"
            limits:
              cpu: "{{ .Config.[[ role.name ]]Cpu }}"
              memory: "{{ .Config.[[ role.name ]]Memory }}"
[% endif %]
[% if engine.roleStorage %]
          storage:
            size: "{{ .Config.[[ role.name ]]StorageSize }}"
[% endif %]
[% endfor %]
[% if extraValues %]
[[ extraValues | toyaml | indent(8, true) ]]
[% endif %]

[% endif %]
[% if service.hasLandingPage %]
    ---
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      name: "{{ .Metadata.Name }}-landing"
    spec:
      hostnames:
        - "[[ service.landingHost ]]"
      parentRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default-awc
          namespace: istio-ingress
      rules:
        - matches:
            - path:
                type: PathPrefix
                value: /
          backendRefs:
            - kind: Service
              name: "[[ service.landingBackend ]]"
              port: [[ service.landingPort ]]
[% endif %]
