apiVersion: [[ apiVersion ]]
kind: Engine
metadata:
  name: [[ engine.name ]]
  annotations:
    ecosystem.awc.cloudera.com/requires-embedded-registry: "true"
spec:
  displayName: "[[ engine.displayName ]]"
  description: "[[ engine.description ]]"
  # Custom resource the [[ operator.chartName ]] Operator reconciles.
  # operator.group, operator.kind, and operator.resource come from the input.
  # Swap the CEL expression for a condition check when the CR uses status.conditions.

  versionCatalog:
    - displayName: "[[ engine.version ]]"
      imageCatalog: [[ imageCatalogName ]]
      chartCatalog: [[ chartCatalogName ]]
      metadata:
        buildVersion: "[[ engine.version ]]"

[% if dependencies.entries %]
  dependencies:
[% for dep in dependencies.entries %]
    - name: [[ dep.name ]]
      engine: [[ dep.engine ]]
      type: [[ dep.type ]]
[% if dep.get("version") is not none %]
      version: "[[ dep.version ]]"
[% endif %]
[% if dep.get("minimumVersion") is not none %]
      minimumVersion: "[[ dep.minimumVersion ]]"
[% endif %]
[% if dep.get("config") %]
      config:
[[ dep.config | toyaml | indent(8, true) ]]
[% endif %]
[% endfor %]

[% endif %]
  configSchema:
    type: object
    properties:
      replicas:
        type: integer
        default: 1
        minimum: 1
        description: "Number of [[ engine.displayName ]] replicas"
      storageSize:
        type: string
        default: "[[ cluster.diskDefault ]]"
        description: "Persistent volume size"

  provides:
[% if service.hasLandingPage %]
    - name: landingPage
      capability: landing-page
      value: |
        url: "https://[[ partner.id ]]-{{ .Metadata.Namespace }}.{{ .Cluster.DomainName }}"
[% endif %]
    - name: endpoint
      capability: service
      value: |
        host: "{{ .Metadata.Name }}.{{ .Metadata.Namespace }}.svc.cluster.local"
        port: [[ service.port ]]

  healthChecks:
[% if operator.group is defined and operator.kind is defined and operator.group and operator.kind %]
    - resource:
        apiVersion: "[[ operator.group ]]/v1"
        kind: "[[ operator.kind ]]"
        name: "{{ .Metadata.Name }}"
      expression: >-
        has(resource.status) &&
        has(resource.status.phase) &&
        resource.status.phase == "Ready"
[% endif %]

  template: |
[% if operator.group is defined and operator.kind is defined and operator.group and operator.kind %]
    apiVersion: [[ operator.group ]]/v1
    kind: [[ operator.kind ]]
    metadata:
      name: "{{ .Metadata.Name }}"
      namespace: "{{ .Metadata.Namespace }}"
    spec:
      instances: "{{ .Config.replicas }}"
      storage:
        size: "{{ .Config.storageSize }}"
[% endif %]
[% if service.hasLandingPage %]
[% if operator.group is defined and operator.kind is defined and operator.group and operator.kind %]
    ---
[% endif %]
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      name: "{{ .Metadata.Name }}-landing"
    spec:
      hostnames:
        - "[[ partner.id ]]-{{ .Metadata.Namespace }}.{{ .Cluster.DomainName }}"
      parentRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default-awc
          namespace: istio-ingress
      rules:
        - matches:
            - path:
                type: PathPrefix
                value: /
          backendRefs:
            - kind: Service
              name: "{{ .Metadata.Name }}"
              port: [[ service.landingPort ]]
[% endif %]
