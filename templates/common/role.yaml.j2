# Namespaced writes under strict ACE RBAC. ace-hub aggregates this Role into the
# engine's namespace-scoped role. Flux helm-controller applies a chart release
# while impersonating the engine ServiceAccount. Legacy mode applies the
# RoleBinding below as written, to ace-operator-controller-manager.
#
# A ClusterRole may not write platform groups (core, apps, and the chart's
# other namespaced objects). Those rules live in this Role.
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: [[ rolePrefix ]]-namespaced-role
rules:
[% if engine.template != "native-k8s" %]
  # `secrets` is Helm's storage driver. Without list on secrets the release
  # fails before creating anything: "cannot list resource secrets in API group".
  # configmaps, persistentvolumeclaims, serviceaccounts and services are what a
  # typical chart renders. `patch` is required: applies go through server-side apply.
  - apiGroups: [""]
    resources:
      - configmaps
      - persistentvolumeclaims
      - secrets
      - serviceaccounts
      - services
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
  # A chart renders a Deployment, a StatefulSet, or both.
  - apiGroups: ["apps"]
    resources:
      - deployments
      - statefulsets
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
  # Readiness checking, not workload management. helm-controller installs with
  # wait enabled. Helm walks a Deployment to its ReplicaSets, and a Service to
  # its EndpointSlices. Both are read-only.
  - apiGroups: ["apps"]
    resources:
      - replicasets
    verbs: ["get", "list", "watch"]
  - apiGroups:
      - discovery.k8s.io
    resources:
      - endpointslices
    verbs: ["get", "list", "watch"]
  - apiGroups:
      - source.toolkit.fluxcd.io
    resources:
      - helmrepositories
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
  - apiGroups:
      - helm.toolkit.fluxcd.io
    resources:
      - helmreleases
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% else %]
  - apiGroups: [""]
    resources: ["services", "secrets", "configmaps"]
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
  - apiGroups: ["apps"]
    resources: ["deployments", "statefulsets"]
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% endif %]
[% if service.hasLandingPage %]
  - apiGroups:
      - gateway.networking.k8s.io
    resources:
      - httproutes
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% endif %]
  - apiGroups:
      - security.awc.cloudera.com
    resources:
      - authconfigs
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% if engine.template == "helm-operator" and operator.group is defined and operator.resource is defined and operator.group and operator.resource %]
  # Custom resource this Engine renders for the installed Operator.
  - apiGroups:
      - "[[ operator.group ]]"
    resources:
      - "[[ operator.resource ]]"
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% endif %]
[% for dep in dependencies.entries %]
[% if dep.type == "auto" %]
  - apiGroups:
      - ecosystem.awc.cloudera.com
    resources:
      - engineinstances
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% endif %]
[% endfor %]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: [[ rolePrefix ]]-namespaced-role-binding
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: [[ rolePrefix ]]-namespaced-role
subjects:
  - kind: ServiceAccount
    name: ace-operator-controller-manager
    namespace: ace-operator-system
[% if engine.template == "helm-operator" %]
---
# Cluster-scoped grant. The operator chart installs CRDs through Flux
# (ace-operator AWC-5129). Kyverno awc-guard-crd-owner bounds which CRDs.
# Bare kind only, no /status. Namespaced writes stay in the Role above.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: [[ rolePrefix ]]-cluster-role
rules:
  - apiGroups: ["apiextensions.k8s.io"]
    resources: ["customresourcedefinitions"]
    verbs: ["create", "get", "list", "patch", "update", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: [[ rolePrefix ]]-cluster-role-binding
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: [[ rolePrefix ]]-cluster-role
subjects:
  - kind: ServiceAccount
    name: ace-operator-controller-manager
    namespace: ace-operator-system
[% endif %]
