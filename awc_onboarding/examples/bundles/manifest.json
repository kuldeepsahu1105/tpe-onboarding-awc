{
  "partner": {
    "id": "puppygraph",
    "owner": "PuppyGraph"
  },
  "engine": {
    "displayName": "PuppyGraph",
    "description": "PuppyGraph 1.x graph query engine deployed via Flux HelmRelease.",
    "template": "helm-multi-role",
    "version": "1.1.0",
    "apiVersion": "v1alpha10",
    "roleStorage": false,
    "roles": [
      {
        "name": "controlplane",
        "replicas": 1,
        "resources": false
      },
      {
        "name": "leader",
        "replicas": 1,
        "cpu": "2",
        "memory": "8Gi"
      },
      {
        "name": "compute",
        "replicas": 1,
        "cpu": "6",
        "memory": "24Gi"
      }
    ],
    "name": "puppygraph-ace-engine",
    "configFromRoles": true
  },
  "helm": {
    "repoUrl": "oci://registry.partner-corp.example.com/puppygraph/charts",
    "chart": "puppygraph",
    "version": "1.0.0",
    "pullPolicy": "Always",
    "values": {
      "secrets": {
        "create": true
      },
      "service": {
        "controlplane": {
          "type": "ClusterIP"
        },
        "query": {
          "type": "ClusterIP"
        }
      }
    },
    "imageRepository": "puppygraph/puppygraph",
    "imageTag": "1.0.0",
    "imageId": "puppygraph",
    "chartId": "puppygraph",
    "valuesTemplate": ""
  },
  "images": [
    {
      "source": "docker.io",
      "repository": "puppygraph/puppygraph",
      "tag": "1.1.0",
      "id": "puppygraph"
    }
  ],
  "config": {
    "extras": [
      {
        "name": "storageSize",
        "default": "200Gi",
        "description": "PVC size for PuppyGraph storage",
        "valuesPath": "storage.size",
        "type": "string"
      },
      {
        "name": "priorityIpCidr",
        "default": "",
        "description": "Cluster node IP CIDR for env.common.PRIORITY_IP_CIDR (recommended)",
        "valuesPath": "env.common.PRIORITY_IP_CIDR",
        "type": "string"
      },
      {
        "name": "username",
        "default": "puppygraph",
        "description": "Initial PuppyGraph UI username",
        "valuesPath": "secrets.PUPPYGRAPH_USERNAME",
        "type": "string"
      },
      {
        "name": "password",
        "default": "changeme",
        "description": "Initial PuppyGraph UI password (override in production)",
        "valuesPath": "secrets.PUPPYGRAPH_PASSWORD",
        "type": "string"
      }
    ]
  },
  "service": {
    "port": 8081,
    "hasLandingPage": true,
    "landingPort": 8081,
    "landingHostPrefix": "puppygraph",
    "domainPrefix": "apps.",
    "landingBackend": "{{ .Metadata.Name }}-controlplane-service",
    "endpointHost": "{{ .Metadata.Name }}-controlplane-service",
    "endpointUrl": true,
    "landingHost": "puppygraph-{{ .Metadata.Namespace }}.apps.{{ .Cluster.DomainName }}"
  },
  "dependencies": {
    "hasAny": false,
    "entries": []
  },
  "blueprint": {
    "needed": true,
    "outcome": "Zero-ETL graph queries",
    "description": "Zero ETL graph on lakehouse data via Helm on AWC.",
    "name": "puppygraph",
    "instanceName": "puppygraph",
    "nodeGroupId": "puppygraph-nodes",
    "nodeGroupDisplayName": "PuppyGraph Nodes"
  },
  "cluster": {
    "minCpu": "8",
    "minMemory": "32Gi",
    "workerCountDefault": 2,
    "diskDefault": "200Gi",
    "diskMinimum": "100Gi",
    "kubernetesVersion": ">= 1.28.0",
    "workerCountMinimum": 1,
    "recommendedCpu": "16",
    "recommendedMemory": "32Gi",
    "hasGPU": false
  },
  "mirror": {
    "skip": true
  },
  "publish": {
    "destinationRegistry": "registry.partner-corp.example.com",
    "namespace": "puppygraph"
  },
  "capability": {
    "exportsStructuredData": false,
    "schema": null
  },
  "apiVersion": "ecosystem.awc.cloudera.com/v1alpha10",
  "provides": [],
  "operator": {},
  "extraValues": {
    "secrets": {
      "create": true,
      "PUPPYGRAPH_USERNAME": "{{ .Config.username }}",
      "PUPPYGRAPH_PASSWORD": "{{ .Config.password }}"
    },
    "service": {
      "controlplane": {
        "type": "ClusterIP"
      },
      "query": {
        "type": "ClusterIP"
      }
    },
    "storage": {
      "size": "{{ .Config.storageSize }}"
    },
    "env": {
      "common": {
        "PRIORITY_IP_CIDR": "{{ .Config.priorityIpCidr }}"
      }
    }
  },
  "test": {
    "landingUrl": ""
  },
  "imageCatalogName": "puppygraph-images-1-1-0",
  "chartCatalogName": "puppygraph-charts-1-0-0",
  "rolePrefix": "puppygraph-ace-engine"
}