apiVersion: [[ apiVersion ]]
kind: Capability
metadata:
  name: [[ capability.name ]]
spec:
  schema:
[% if capability.schema %]
[[ capability.schema | toyaml | indent(4, true) ]]
[% else %]
    type: object
    required:
[% for f in capability.fields %]
      - [[ f.name ]]
[% endfor %]
    properties:
[% for f in capability.fields %]
      [[ f.name ]]:
        type: [[ f.type ]]
[% endfor %]
[% endif %]
