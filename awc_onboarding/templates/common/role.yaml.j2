# RBAC so the ACE operator (running as the ace-operator-controller-manager
# ServiceAccount) is allowed to manage the resources this Engine's template
# renders. Adjust apiGroups/resources if you add/remove objects from the
# Engine template.
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: [[ rolePrefix ]]-role-binding
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: [[ rolePrefix ]]-role
subjects:
  - kind: ServiceAccount
    name: ace-operator-controller-manager
    namespace: ace-operator-system

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: [[ rolePrefix ]]-role
rules:
[% if engine.template != "native-k8s" %]
  - apiGroups:
      - source.toolkit.fluxcd.io
    resources:
      - helmrepositories
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
  - apiGroups:
      - helm.toolkit.fluxcd.io
    resources:
      - helmreleases
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% endif %]
[% if service.hasLandingPage %]
  - apiGroups:
      - gateway.networking.k8s.io
    resources:
      - httproutes
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% endif %]
  - apiGroups:
      - security.awc.cloudera.com
    resources:
      - authconfigs
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% if engine.template == "native-k8s" %]
  - apiGroups: [""]
    resources: ["services", "secrets", "configmaps"]
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
  - apiGroups: ["apps"]
    resources: ["deployments", "statefulsets"]
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% endif %]
[% if engine.template == "helm-operator" %]
  # The CR(s) this Engine's template renders for the installed Operator to
  # reconcile. Replace <group>/<resource> with the real CRD this operator
  # exposes (e.g. postgresql.cnpg.io / clusters).
  - apiGroups:
      - "<operator-crd-group>"
    resources:
      - "<operator-crd-resource>"
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% endif %]
[% for dep in dependencies.entries %]
[% if dep.type == "auto" %]
  - apiGroups:
      - ecosystem.awc.cloudera.com
    resources:
      - engineinstances
    verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
[% endif %]
[% endfor %]
