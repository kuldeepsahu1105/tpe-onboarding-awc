apiVersion: ecosystem.awc.cloudera.com/v1alpha9
kind: ImageCatalog
metadata:
  name: [[ imageCatalogName ]]
spec:
  images:
[% for img in images %]
    - id: [[ img.id ]]
      registry: [[ publish.destinationRegistry ]]
      repository: [[ publish.namespace ]]/[[ img.repository ]]
      tag: "[[ img.tag ]]"
[% endfor %]
