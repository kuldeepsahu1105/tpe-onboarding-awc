apiVersion: ecosystem.awc.cloudera.com/v1alpha9
kind: ImageCatalog
metadata:
  name: [[ imageCatalogName ]]
spec:
  images:
    - id: [[ helm.imageId ]]
      registry: [[ publish.destinationRegistry ]]
      repository: [[ publish.namespace ]]/[[ helm.imageRepository | default(partner.id) ]]
      tag: "[[ helm.imageTag ]]"
