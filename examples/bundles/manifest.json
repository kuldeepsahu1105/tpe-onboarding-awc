{
  "partner": {
    "id": "starrocks",
    "owner": "StarRocks"
  },
  "engine": {
    "displayName": "StarRocks",
    "description": "Blazing-fast OLAP analytics engine (FE + BE) via the kube-starrocks chart.",
    "template": "helm-multi-role",
    "version": "1.11.4",
    "roles": [
      {
        "name": "fe",
        "replicas": 1
      },
      {
        "name": "be",
        "replicas": 1
      }
    ],
    "configFromRoles": false,
    "name": "starrocks-ace-engine",
    "apiVersion": "v1alpha10",
    "roleStorage": true
  },
  "helm": {
    "repoUrl": "https://starrocks.github.io/starrocks-kubernetes-operator",
    "chart": "kube-starrocks",
    "version": "1.11.4",
    "valuesTemplate": "operator:\n  nameOverride: \"{{ .Metadata.Name }}\"\n  starrocksOperator:\n    enabled: true\n    image:\n      repository: \"{{ .Image.starrocksOperator.registry }}/{{ .Image.starrocksOperator.repository }}\"\n      tag: \"{{ .Image.starrocksOperator.tag }}\"\nstarrocks:\n  nameOverride: \"{{ .Metadata.Name }}\"\n  starrocksCluster:\n    name: \"{{ .Metadata.Name }}\"\n  starrocksFESpec:\n    replicas: {{ .Config.feReplicas }}\n    image:\n      repository: \"{{ .Image.fe.registry }}/{{ .Image.fe.repository }}\"\n      tag: \"{{ .Image.fe.tag }}\"\n    resources:\n      requests: {cpu: \"{{ .Config.feCpu }}\", memory: \"{{ .Config.feMemory }}\"}\n      limits: {cpu: \"{{ .Config.feCpu }}\", memory: \"{{ .Config.feMemory }}\"}\n    storageSpec:\n      name: fe\n      storageSize: \"{{ .Config.feMetaStorageSize }}\"\n      logStorageSize: \"{{ .Config.feLogStorageSize }}\"\n  starrocksBeSpec:\n    replicas: {{ .Config.beReplicas }}\n    image:\n      repository: \"{{ .Image.be.registry }}/{{ .Image.be.repository }}\"\n      tag: \"{{ .Image.be.tag }}\"\n    resources:\n      requests: {cpu: \"{{ .Config.beCpu }}\", memory: \"{{ .Config.beMemory }}\"}\n      limits: {cpu: \"{{ .Config.beCpu }}\", memory: \"{{ .Config.beMemory }}\"}\n    storageSpec:\n      name: be\n      storageSize: \"{{ .Config.beStorageSize }}\"\n      logStorageSize: \"{{ .Config.beLogStorageSize }}\"\n",
    "imageRepository": "starrocks/operator",
    "imageTag": "1.11.4",
    "imageId": "starrocksOperator",
    "chartId": "kubeStarrocks",
    "pullPolicy": ""
  },
  "images": [
    {
      "source": "docker.io",
      "repository": "starrocks/operator",
      "tag": "v1.11.4",
      "id": "starrocksOperator"
    },
    {
      "source": "docker.io",
      "repository": "starrocks/fe-ubuntu",
      "tag": "3.4.3",
      "id": "fe"
    },
    {
      "source": "docker.io",
      "repository": "starrocks/be-ubuntu",
      "tag": "3.4.3",
      "id": "be"
    }
  ],
  "config": {
    "extras": [
      {
        "name": "feReplicas",
        "type": "integer",
        "minimum": 1,
        "default": 1,
        "title": "FE Replicas",
        "description": "Number of FE (Frontend) replicas"
      },
      {
        "name": "beReplicas",
        "type": "integer",
        "minimum": 1,
        "default": 1,
        "title": "BE Replicas",
        "description": "Number of BE (Backend) replicas"
      },
      {
        "name": "feCpu",
        "type": "string",
        "default": "2",
        "title": "FE CPU",
        "description": "CPU request and limit for each FE pod"
      },
      {
        "name": "feMemory",
        "type": "string",
        "default": "4Gi",
        "title": "FE Memory",
        "description": "Memory request and limit for each FE pod"
      },
      {
        "name": "feMetaStorageSize",
        "type": "string",
        "default": "10Gi",
        "title": "FE Meta Storage",
        "description": "FE metadata PVC size"
      },
      {
        "name": "feLogStorageSize",
        "type": "string",
        "default": "5Gi",
        "title": "FE Log Storage",
        "description": "FE log PVC size"
      },
      {
        "name": "beCpu",
        "type": "string",
        "default": "2",
        "title": "BE CPU",
        "description": "CPU request and limit for each BE pod"
      },
      {
        "name": "beMemory",
        "type": "string",
        "default": "4Gi",
        "title": "BE Memory",
        "description": "Memory request and limit for each BE pod"
      },
      {
        "name": "beStorageSize",
        "type": "string",
        "default": "20Gi",
        "title": "BE Storage",
        "description": "BE data PVC size"
      },
      {
        "name": "beLogStorageSize",
        "type": "string",
        "default": "1Gi",
        "title": "BE Log Storage",
        "description": "BE log PVC size"
      }
    ]
  },
  "service": {
    "port": 9030,
    "hasLandingPage": true,
    "landingPort": 8030,
    "landingHost": "{{ .Metadata.Name }}.{{ .Cluster.DomainName }}",
    "landingBackend": "{{ .Metadata.Name }}-fe-service",
    "landingHostPrefix": "starrocks",
    "domainPrefix": "",
    "endpointHost": "{{ .Metadata.Name }}",
    "endpointUrl": false
  },
  "capability": {
    "exportsStructuredData": true,
    "name": "starrocks-cluster",
    "fields": [],
    "schema": {
      "type": "object",
      "required": [
        "queryEndpoint",
        "httpEndpoint"
      ],
      "properties": {
        "queryEndpoint": {
          "type": "object",
          "description": "MySQL-compatible query endpoint (port 9030)",
          "required": [
            "host",
            "port"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "httpEndpoint": {
          "type": "object",
          "description": "HTTP API endpoint (port 8030)",
          "required": [
            "host",
            "port"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "provides": [
    {
      "name": "starrocksLandingPage",
      "capability": "landing-page",
      "value": "url: \"https://{{ .Metadata.Name }}.{{ .Cluster.DomainName }}\"\n"
    },
    {
      "name": "starrocksCluster",
      "capability": "starrocks-cluster",
      "value": "queryEndpoint:\n  host: \"{{ .Metadata.Name }}-fe-service.{{ .Metadata.Namespace }}.svc.cluster.local\"\n  port: 9030\nhttpEndpoint:\n  host: \"{{ .Metadata.Name }}-fe-service.{{ .Metadata.Namespace }}.svc.cluster.local\"\n  port: 8030\n"
    }
  ],
  "dependencies": {
    "hasAny": false,
    "entries": []
  },
  "blueprint": {
    "needed": true,
    "outcome": "OLAP analytics",
    "name": "starrocks",
    "description": "Blazing-fast OLAP analytics engine (FE + BE) via the kube-starrocks chart.",
    "instanceName": "starrocks",
    "nodeGroupId": "starrocks-nodes",
    "nodeGroupDisplayName": "StarRocks Nodes",
    "format": "current",
    "minimumVersion": "1.11.4"
  },
  "cluster": {
    "minCpu": "8",
    "minMemory": "32Gi",
    "kubernetesVersion": ">= 1.28.0",
    "workerCountDefault": 1,
    "workerCountMinimum": 1,
    "recommendedCpu": "16",
    "recommendedMemory": "32Gi",
    "diskDefault": "100Gi",
    "diskMinimum": "50Gi",
    "hasGPU": false
  },
  "publish": {
    "destinationRegistry": "registry.partner-corp.example.com",
    "namespace": "starrocks"
  },
  "mirror": {
    "skip": false,
    "chart": {
      "repoUrl": "https://starrocks.github.io/starrocks-kubernetes-operator",
      "name": "kube-starrocks",
      "version": "1.11.4"
    },
    "image": {
      "repository": "starrocks/operator",
      "tag": "1.11.4"
    }
  },
  "apiVersion": "ecosystem.awc.cloudera.com/v1alpha10",
  "operator": {},
  "extraValues": {},
  "test": {
    "landingUrl": ""
  },
  "imageCatalogName": "starrocks-images-1-11-4",
  "chartCatalogName": "starrocks-charts-1-11-4",
  "rolePrefix": "starrocks-ace-engine"
}